{
  // Re-run after every game patch: proves the reflection self-check still passes and the
  // ReceiveDamage(DamageSourceData) patch survives real kills without errors.
  "name": "dragonblade-compat-smoke",
  "mod": "kumo.sulfur.melee_expansion",
  "description": "Startup: the self-check passes (no missing member, no arity mismatch) and every Harmony patch applies. Steps: kill enemies through the player's damage path, which runs the patched Unit.ReceiveDamage(float, DamageSourceData, Hitmesh.Data, Vector3?) prefix/postfix. The dash strike itself is NOT covered: it needs Toggle Melee Stance's stance, entered with the melee key, and on the reference machine that key is a mouse side button the input tool cannot press. Check the dash by hand (stance on, sprint key at an enemy: 'Katana Dash hit unit' and an HP drop). Needs a save slot that starts at the hub; slot 3 was mid-run after the 2026-11-01 session.",
  "setup": { "slot": 3, "chapter": "Act_01_Sewers", "seed": 20261101, "godMode": true, "instances": ["host"] },
  "steps": [
    { "label": "enable dash/kill debug log", "do": "call", "instance": "host", "method": "config_set",
      "args": { "guid": "kumo.sulfur.melee_expansion", "section": "Debug", "key": "LogDash", "value": "true" } },
    { "label": "kill through the patched ReceiveDamage", "do": "kill_enemies", "instance": "host", "count": 3 },
    { "do": "wait", "seconds": 2 },
    { "do": "screenshot", "instance": "host" }
  ],
  "assertions": [
    { "name": "plugin loaded", "instance": "host", "scope": "startup", "pattern": "\\[Info\\s*:The Dragonblade\\] The Dragonblade loaded", "op": ">=", "value": 1 },
    { "name": "no missing member", "instance": "host", "scope": "startup", "pattern": "Missing required member", "op": "==", "value": 0 },
    { "name": "no arity mismatch", "instance": "host", "scope": "startup", "pattern": "Incompatible signature for required member", "op": "==", "value": 0 },
    { "name": "patches applied", "instance": "host", "scope": "startup", "pattern": "Reflection initialization failed|Mod will not patch", "op": "==", "value": 0 },
    { "name": "no Harmony failure", "instance": "host", "scope": "startup", "pattern": "HarmonyException|Failed to patch", "op": "==", "value": 0 },
    { "name": "no DamageSourceData read failure", "instance": "host", "scope": "steps", "pattern": "Failed to read DamageSourceData", "op": "==", "value": 0 },
    { "name": "no dash damage failure", "instance": "host", "scope": "steps", "pattern": "Failed to apply Katana Dash damage", "op": "==", "value": 0 },
    { "name": "no mod errors", "instance": "host", "scope": "steps", "pattern": "\\[Error\\s*:The Dragonblade\\]", "op": "==", "value": 0 }
  ]
}
