    },
    {
      "key": "entry.KatanaDash.RefreshRequiresKatanaStance.description",
      "value": "If true, kill refresh only works while the player is in toggled katana stance."
    },
    {
      "key": "entry.KatanaDash.RefreshCooldownOnNonNpcUnitKill.name",
      "value": "擊殺非 NPC 單位時重置冷卻"
    },
    {
      "key": "entry.KatanaDash.RefreshCooldownOnNonNpcUnitKill.description",
      "value": "If true, killing non-NPC Units such as breakable obstacles can also refresh Katana Dash cooldown. Healing never triggers from non-NPC Units."
    },
    {
      "key": "entry.KatanaDash.HealOnEnemyKill.name",
      "value": "擊殺敵人時回復 HP"
    },
    {
      "key": "entry.KatanaDash.HealOnEnemyKill.description",
      "value": "Heal the player when killing an enemy NPC while in katana stance. This never triggers from breakable obstacles."
    },
    {
      "key": "entry.KatanaDash.HealAmountOnEnemyKill.name",
      "value": "擊殺敵人 HP 回復量"
    },
    {
      "key": "entry.KatanaDash.HealAmountOnEnemyKill.description",
      "value": "Health restored when killing an enemy NPC."
    },
    {
